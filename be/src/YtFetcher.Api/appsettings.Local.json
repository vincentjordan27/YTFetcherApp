{
  "Service": {
    "Name": "yt-fetcher"
  },
  "Database": {
    "Host": "<replace-with-local-database-host>",
    "Port": 5432,
    "Name": "<replace-with-local-database-name>",
    "Username": "<replace-with-local-database-username>",
    "Password": "<replace-with-local-database-password>"
  },
  "YouTube": {
    "ApiKey": "<replace-with-local-youtube-api-key>",
    "QueriesDailyQuotaLimit": 10000,
    "VideoBatchGetStatsDailyQuotaLimit": 10000,
    "SearchQueriesDailyQuotaLimit": 100,
    "DiscoveryMaxPagesPerKeywordPerRun": 1,
    "MaxDailyApprovedChannels": 500,
    "BackfillPageLimit": 3,
    "BackfillDispatchBatchSize": 10
  },
  "Auth": {
    "Enabled": false,
    "FrontendOrigin": "<replace-with-the-frontend-origin-for-this-deployment>",
    "Jwt": {
      "Issuer": "<replace-with-a-session-issuer-name>",
      "Audience": "<replace-with-a-session-audience-name>",
      "SigningKey": "<replace-with-at-least-32-random-characters>",
      "SessionLifetimeMinutes": 720
    },
    "Firebase": {
      "ProjectId": "<replace-with-the-firebase-project-id>",
      "ServiceAccountFilePath": "<replace-with-the-mounted-firebase-admin-sdk-json-path>"
    }
  },
  "Grafana": {
    "LokiUrl": "LokiUrl",
    "Username": "GrafanaUsername",
    "Token": "GrafanaToken"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
