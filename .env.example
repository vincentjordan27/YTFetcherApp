# Copy this file to .env on the VPS, then replace every placeholder.
# Docker Compose reads .env automatically when it runs from this directory.

# Existing PostgreSQL connection
DATABASE_HOST=local-postgres
DATABASE_PORT=5432
DATABASE_NAME=yt_fetcher
DATABASE_USERNAME=<replace-with-database-user>
DATABASE_PASSWORD=<replace-with-database-password>
DATABASE_NETWORK=local-platform

# YouTube Data API
YOUTUBE_API_KEY=<replace-with-youtube-api-key>
YOUTUBE_QUERIES_DAILY_QUOTA_LIMIT=10000
YOUTUBE_VIDEO_BATCH_STATS_DAILY_QUOTA_LIMIT=10000
YOUTUBE_SEARCH_QUERIES_DAILY_QUOTA_LIMIT=100
YOUTUBE_DISCOVERY_MAX_PAGES=1
YOUTUBE_MAX_DAILY_APPROVED_CHANNELS=100
YOUTUBE_BACKFILL_PAGE_LIMIT=3
YOUTUBE_BACKFILL_DISPATCH_BATCH_SIZE=10

# API runtime
AUTH_ENABLED=false
AUTH_FRONTEND_ORIGIN=https://yt.domain.com
HANGFIRE_DASHBOARD_ENABLED=false

# Optional Grafana Loki log shipping. Leave all three blank to keep logs in Docker only.
GRAFANA_LOKI_URL=
GRAFANA_USERNAME=
GRAFANA_TOKEN=

# Required only when AUTH_ENABLED=true
AUTH_JWT_ISSUER=yt-fetcher
AUTH_JWT_AUDIENCE=yt-fetcher-web
AUTH_JWT_SIGNING_KEY=<replace-with-a-long-random-secret>
AUTH_JWT_SESSION_LIFETIME_MINUTES=480
AUTH_FIREBASE_PROJECT_ID=<replace-with-firebase-project-id>
# Host path only. The JSON content never belongs in this file or in Git.
# Uncomment when AUTH_ENABLED=true:
# FIREBASE_ADMIN_SDK_PATH=/etc/yt-fetcher/secrets/firebase-admin-sdk.json

# Public Firebase web configuration. Required only when AUTH_ENABLED=true.
VITE_FIREBASE_API_KEY=<replace-with-firebase-web-api-key>
VITE_FIREBASE_AUTH_DOMAIN=<replace-with-firebase-auth-domain>
VITE_FIREBASE_PROJECT_ID=<replace-with-firebase-project-id>
VITE_FIREBASE_APP_ID=<replace-with-firebase-web-app-id>
